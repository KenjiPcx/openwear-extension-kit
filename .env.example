# Get a key at https://platform.decart.ai and copy this file to .env.
DECART_API_KEY=
PORT=3000
# Set before exposing the app publicly. Users enter this demo access code.
DEMO_ACCESS_CODE=
# Session duration is enforced by Decart and by the browser.
SESSION_SECONDS=120
# Optional: lock extension tokens to one installed extension ID for shared demos.
EXTENSION_ID=
